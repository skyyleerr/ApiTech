SENSOR_API_DATABASE_URL=sqlite:///./sensor_api.sqlite3
SENSOR_API_HOST=127.0.0.1
SENSOR_API_PORT=8080
SENSOR_API_GENERATOR_INTERVAL=60
# Solo desarrollo local; remoto debe usar HTTPS detrás de un proxy TLS.
SENSOR_API_ALLOW_HTTP=false

# Mockaroo: schema guardado con los campos temperature, humidity y weight.
MOCKAROO_API_KEY=
MOCKAROO_SCHEMA=
MOCKAROO_URL=https://api.mockaroo.com/api/generate.json

# MockAPI.io: URL del proyecto, sin barra final. Recurso REST de lecturas.
MOCKAPI_BASE_URL=
MOCKAPI_READINGS_RESOURCE=readings
MOCKAPI_TOKEN=
PROVIDER_HTTP_TIMEOUT=8
