# Copiar a .env. No subir .env ni respaldos reales a GitHub.
DJANGO_SECRET_KEY=REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA_DE_50_CARACTERES
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
APP_TIME_ZONE=America/Bogota

# sqlite: inicio rápido. mysql: instalación definitiva MySQL/MariaDB.
DB_ENGINE=sqlite
DB_NAME=apitech_mk6
DB_USER=apitech_mk6
DB_PASSWORD=CAMBIAR
DB_HOST=127.0.0.1
DB_PORT=3306

# Solo al trasladar datos: una COPIA MK5 distinta del destino.
LEGACY_DB_NAME=apitech_mk5_copia

# API de Karen: vacíos hasta tener URL y token reales. No existe modo fake.
# El sufijo es el ID INTERNO de la empresa MK6 (ver docs/Contrato_API_Karen.md).
# SENSOR_API_URL_1=https://su-api.example/v1
# SENSOR_API_TOKEN_1=TOKEN_EXCLUSIVO_EMPRESA_1
# Defaults opcionales si el proveedor usa una URL común:
SENSOR_API_BASE_URL=
SENSOR_API_TOKEN=
# Permitir HTTP solo para localhost/127.0.0.1 durante desarrollo de la API.
SENSOR_API_ALLOW_LOCAL=False
